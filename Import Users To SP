<!DOCTYPE html>
<html>
<head>
    <title>Import SharePoint Group Data</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <input type="file" id="uploadJsonFile" />
    <button id="importDataBtn">Import Data</button>
    
    <script type="text/javascript">
        $(document).ready(function() {
            var jsonData;

            $("#uploadJsonFile").change(function(event) {
                var file = event.target.files[0];
                var reader = new FileReader();
                reader.onload = function(e) {
                    jsonData = JSON.parse(e.target.result);
                };
                reader.readAsText(file);
            });

            $("#importDataBtn").click(function() {
                if (!jsonData) {
                    alert("Please upload a JSON file first.");
                    return;
                }

                for (var i = 0; i < jsonData.length; i++) {
                    var groupTitle = jsonData[i].GroupTitle;
                    var emails = jsonData[i].Emails.split("; ").filter(Boolean);
                    createGroup(groupTitle, emails);
                }
            });

            function createGroup(groupTitle, emails) {
                $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups",
                    method: "POST",
                    headers: {
                        "Accept": "application/json; odata=verbose",
                        "Content-Type": "application/json; odata=verbose",
                        "X-RequestDigest": $("#__REQUESTDIGEST").val()
                    },
                    data: JSON.stringify({
                        "__metadata": { "type": "SP.Group" },
                        "Title": groupTitle
                    }),
                    success: function(data) {
                        var groupId = data.d.Id;
                        removeUsersFromGroup(groupId, function() {
                            addUsersToGroup(groupId, emails);
                        });
                    },
                    error: function(error) {
                        console.log(JSON.stringify(error));
                    }
                });
            }

            function removeUsersFromGroup(groupId, callback) {
                $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups/getbyid(" + groupId + ")/users",
                    method: "GET",
                    headers: {
                        "Accept": "application/json; odata=verbose"
                    },
                    success: function(data) {
                        var users = data.d.results;
                        var promises = [];
                        for (var i = 0; i < users.length; i++) {
                            var userId = users[i].Id;
                            promises.push(removeUserFromGroup(groupId, userId));
                        }
                        $.when.apply($, promises).done(function() {
                            callback();
                        });
                    },
                    error: function(error) {
                        console.log(JSON.stringify(error));
                    }
                });
            }

            function removeUserFromGroup(groupId, userId) {
                return $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups/getbyid(" + groupId + ")/users/removebyid(" + userId + ")",
                    method: "POST",
                    headers: {
                        "Accept": "application/json; odata=verbose",
                        "X-RequestDigest": $("#__REQUESTDIGEST").val()
                    },
                    success: function(data) {
                        console.log("User ID " + userId + " removed from group ID " + groupId);
                    },
                    error: function(error) {
                        console.log(JSON.stringify(error));
                    }
                });
            }

            function addUsersToGroup(groupId, emails) {
                for (var i = 0; i < emails.length; i++) {
                    var email = emails[i];
                    $.ajax({
                        url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups/getbyid(" + groupId + ")/users/add",
                        method: "POST",
                        headers: {
                            "Accept": "application/json; odata=verbose",
                            "Content-Type": "application/json; odata=verbose",
                            "X-RequestDigest": $("#__REQUESTDIGEST").val()
                        },
                        data: JSON.stringify({
                            "__metadata": { "type": "SP.User" },
                            "Email": email
                        }),
                        success: function(data) {
                            console.log("User " + email + " added to group ID " + groupId);
                        },
                        error: function(error) {
                            console.log(JSON.stringify(error));
                        }
                    });
                }
            }
        });
    </script>
</body>
</html>
