<!DOCTYPE html>
<html>
<head>
    <title>Import SharePoint Group Data</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <input type="file" id="uploadJsonFile" />
    <button id="importDataBtn" type="button">Import Data</button>
    
    <script type="text/javascript">
        $(document).ready(function() {
            var jsonData;

            // Read JSON file and store data
            $("#uploadJsonFile").change(function(event) {
                var file = event.target.files[0];
                var reader = new FileReader();
                reader.onload = function(e) {
                    jsonData = JSON.parse(e.target.result);
                };
                reader.readAsText(file);
            });

            // Handle the import button click
            $("#importDataBtn").click(function() {
                if (!jsonData) {
                    alert("Please upload a JSON file first.");
                    return;
                }

                jsonData.forEach(function(group) {
                    var groupTitle = group.GroupTitle;
                    var emails = group.Emails.split("; ").filter(Boolean);
                    processGroup(groupTitle, emails);
                });
            });

            // Check if group exists, create if not, then add users
            function processGroup(groupTitle, emails) {
                $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups?$filter=Title eq '" + groupTitle + "'",
                    method: "GET",
                    headers: {
                        "Accept": "application/json; odata=verbose"
                    },
                    success: function(data) {
                        if (data.d.results.length > 0) {
                            var groupId = data.d.results[0].Id;
                            console.log("Group " + groupTitle + " exists with ID " + groupId);
                            removeUsersFromGroup(groupId, function() {
                                addUsersToGroup(groupId, emails);
                            });
                        } else {
                            console.log("Group " + groupTitle + " does not exist. Creating group.");
                            createGroup(groupTitle, emails);
                        }
                    },
                    error: function(error) {
                        console.error("Error checking for group " + groupTitle + ": ", error);
                    }
                });
            }

            // Create group and then add users
            function createGroup(groupTitle, emails) {
                $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups",
                    method: "POST",
                    headers: {
                        "Accept": "application/json; odata=verbose",
                        "Content-Type": "application/json; odata=verbose",
                        "X-RequestDigest": $("#__REQUESTDIGEST").val()
                    },
                    data: JSON.stringify({
                        "__metadata": { "type": "SP.Group" },
                        "Title": groupTitle
                    }),
                    success: function(data) {
                        var groupId = data.d.Id;
                        console.log("Created group " + groupTitle + " with ID " + groupId);
                        addUsersToGroup(groupId, emails);
                    },
                    error: function(error) {
                        console.error("Error creating group " + groupTitle + ": ", error);
                    }
                });
            }

            // Remove all users from group before adding new ones
            function removeUsersFromGroup(groupId, callback) {
                $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups/getbyid(" + groupId + ")/users",
                    method: "GET",
                    headers: {
                        "Accept": "application/json; odata=verbose"
                    },
                    success: function(data) {
                        var users = data.d.results;
                        var promises = users.map(function(user) {
                            return removeUserFromGroup(groupId, user.Id);
                        });
                        $.when.apply($, promises).done(callback);
                    },
                    error: function(error) {
                        console.error("Error fetching users for group ID " + groupId + ": ", error);
                    }
                });
            }

            // Remove a single user from group
            function removeUserFromGroup(groupId, userId) {
                return $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups/getbyid(" + groupId + ")/users/removebyid(" + userId + ")",
                    method: "POST",
                    headers: {
                        "Accept": "application/json; odata=verbose",
                        "X-RequestDigest": $("#__REQUESTDIGEST").val()
                    },
                    success: function(data) {
                        console.log("User ID " + userId + " removed from group ID " + groupId);
                    },
                    error: function(error) {
                        console.error("Error removing user ID " + userId + " from group ID " + groupId + ": ", error);
                    }
                });
            }

            // Add users to the group
            function addUsersToGroup(groupId, emails) {
                emails.forEach(function(email) {
                    $.ajax({
                        url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups/getbyid(" + groupId + ")/users/add",
                        method: "POST",
                        headers: {
                            "Accept": "application/json; odata=verbose",
                            "Content-Type": "application/json; odata=verbose",
                            "X-RequestDigest": $("#__REQUESTDIGEST").val()
                        },
                        data: JSON.stringify({
                            "__metadata": { "type": "SP.User" },
                            "Email": email
                        }),
                        success: function(data) {
                            console.log("User " + email + " added to group ID " + groupId);
                        },
                        error: function(error) {
                            console.error("Error adding user " + email + " to group ID " + groupId + ": ", error);
                        }
                    });
                });
            }
        });
    </script>
</body>
</html>
