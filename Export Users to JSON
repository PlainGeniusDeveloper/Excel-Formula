<!DOCTYPE html>
<html>
<head>
    <title>Extract SharePoint Group Data</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <button id="exportDataBtn">Export Data</button>
    <pre id="jsonData" style="display: none;"></pre>
    
    <script type="text/javascript">
        $(document).ready(function() {
            $("#exportDataBtn").click(function() {
                var allGroupsData = [];
                $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups",
                    method: "GET",
                    headers: {
                        "Accept": "application/json; odata=verbose"
                    },
                    success: function(data) {
                        var groups = data.d.results;
                        var promises = [];
                        for (var i = 0; i < groups.length; i++) {
                            var groupId = groups[i].Id;
                            var groupName = groups[i].Title;
                            promises.push(getGroupEmails(groupId, groupName, allGroupsData));
                        }

                        $.when.apply($, promises).done(function() {
                            var jsonData = JSON.stringify(allGroupsData, null, 2);
                            $("#jsonData").text(jsonData).show();
                            download("sharepoint_groups.json", jsonData);
                        });
                    },
                    error: function(error) {
                        console.log(JSON.stringify(error));
                    }
                });
            });

            function getGroupEmails(groupId, groupName, allGroupsData) {
                return $.ajax({
                    url: _spPageContextInfo.webAbsoluteUrl + "/_api/web/sitegroups/getbyid(" + groupId + ")/users",
                    method: "GET",
                    headers: {
                        "Accept": "application/json; odata=verbose"
                    },
                    success: function(data) {
                        var users = data.d.results;
                        var emailList = [];
                        for (var i = 0; i < users.length; i++) {
                            emailList.push(users[i].Email);
                        }
                        allGroupsData.push({
                            "GroupTitle": groupName,
                            "Emails": emailList.join("; ")
                        });
                    },
                    error: function(error) {
                        console.log(JSON.stringify(error));
                    }
                });
            }

            function download(filename, text) {
                var element = document.createElement('a');
                element.setAttribute('href', 'data:text/json;charset=utf-8,' + encodeURIComponent(text));
                element.setAttribute('download', filename);
                element.style.display = 'none';
                document.body.appendChild(element);
                element.click();
                document.body.removeChild(element);
            }
        });
    </script>
</body>
</html>
